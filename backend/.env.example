# Copy to backend/.env and fill in. This file is git-ignored.
# Database
DATABASE_URL=postgresql+asyncpg://senus:senus_dev@localhost:5432/senus_board

# Groq API (get a free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Set to true to log every SQL statement (noisy)
SQL_ECHO=false
